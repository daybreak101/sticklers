{
  "expo": {
    "name": "sticklersApp",
    "slug": "sticklersApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sticklersapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "extra": {
      "firebaseApiKey": "AIzaSyCFEqM43LEJnEUvS1n2rAfeRgOWBKfEWAo",
      "firebaseAuthDomain": "sticklers.firebaseapp.com",
      "firebaseProjectId": "sticklers",
      "firebaseStorageBucket": "sticklers.firebasestorage.app",
      "firebaseMessagingSenderId": "1093354481594",
      "firebaseAppId": "1:1093354481594:web:415c4e7ee209b1ab4b9f83"
    },

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rferna25.sticklersapp"
    },
    "android": {
      "package": "com.rferna25.sticklersapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
